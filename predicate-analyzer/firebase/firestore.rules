rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsMeeting(meetingId) {
      return signedIn()
        && get(/databases/$(database)/documents/meetings/$(meetingId)).data.ownerId
          == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /meetings/{meetingId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /segments/{segmentId} {
        allow read, write: if ownsMeeting(meetingId);
      }

      match /analysis/{analysisId} {
        allow read, write: if ownsMeeting(meetingId);
      }

      match /actionItems/{actionItemId} {
        allow read, write: if ownsMeeting(meetingId);
      }
    }
  }
}
